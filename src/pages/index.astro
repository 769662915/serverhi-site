---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ManualIcon from '../components/ManualIcon.astro';
import SearchField from '../components/SearchField.astro';
import TopicDirectory from '../components/TopicDirectory.astro';
import OrganizationSchema from '../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';
import { getAllPosts, getFeaturedPosts } from '../lib/posts';
import { publishedTasks } from '../lib/manual';
import rackPhoto from '../content/posts/gitlab-19-6-1-cve-2026-132825-ruby/cover.webp';

const [posts, featured] = await Promise.all([getAllPosts(), getFeaturedPosts()]);
const recovery = posts.find(post => post.slug === 'backup-strategies');
const recentPosts = posts.slice(0, 5);
const featuredPosts = featured.filter(post => !recentPosts.some(recent => recent.slug === post.slug));
const symptoms = publishedTasks('troubleshooting', posts);
---

<BaseLayout>
  <OrganizationSchema />
  <WebSiteSchema />
  <div class="container">
    <section class="intro">
      <div class="intro-copy">
        <h1>The Linux<br class="title-break" /> operations manual<span class="title-period">.</span></h1>
        <p>Find Linux, Docker, and DevOps guides by service, task, or the error you’re looking at.</p>
        <SearchField id="home-search" placeholder="Try “nginx 502”…" />
      </div>
      {recovery && (
        <a class="lead-guide" href={`/posts/${recovery.slug}/`}>
          <Image src={rackPhoto} alt="A lit server rack in a dark data center" widths={[480, 760, 1040]} sizes="(max-width: 48rem) 92vw, (max-width: 78rem) 44vw, 565px" width={1040} height={585} quality={82} loading="eager" fetchpriority="high" />
          <div class="lead-copy">
            <span class="micro-label">Recovery walkthrough</span>
            <div class="lead-title">
              <h2>Verify a PostgreSQL backup</h2>
              <span class="lead-arrow"><ManualIcon name="diagonal" size={22} /></span>
            </div>
            <p>Restore a database dump and check the off-site copy.</p>
          </div>
        </a>
      )}
    </section>

    <div class="entry-points">
      <section id="topics" aria-labelledby="topics-title">
        <div class="section-line"><h2 id="topics-title" class="section-heading">Browse by topic</h2></div>
        <TopicDirectory />
      </section>

      {symptoms.length > 0 && (
        <section class="symptoms" aria-labelledby="symptoms-title">
          <h2 id="symptoms-title"><ManualIcon name="pulse" size={22} /> Start with a symptom</h2>
          <ul class="list-reset">
            {symptoms.map(task => (
              <li><a href={`/posts/${task.slug}/`}>{task.label}<ManualIcon name="right" size={16} /></a></li>
            ))}
          </ul>
          <a class="text-link more-symptoms" href="/category/troubleshooting/">All troubleshooting guides <ManualIcon name="arrow" size={16} /></a>
        </section>
      )}
    </div>

    <section class="latest" aria-labelledby="latest-title">
      <div class="section-line">
        <h2 id="latest-title" class="section-heading">Latest articles</h2>
        <a class="text-link" href="/archive/">Browse archive <ManualIcon name="arrow" size={16} /></a>
      </div>
      <ul class="article-list">
        {recentPosts.map(post => <li><ArticleCard post={post} showCategory /></li>)}
      </ul>
    </section>

    {featuredPosts.length > 0 && (
      <section class="featured" aria-labelledby="featured-title">
        <div class="section-line"><h2 id="featured-title" class="section-heading">Featured from the archive</h2></div>
        <ul class="article-list">
          {featuredPosts.map(post => <li><ArticleCard post={post} showCategory /></li>)}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); align-items: center; gap: clamp(1.75rem, 5vw, 5rem); padding: clamp(2rem, 4.7vw, 4.6rem) 0 clamp(2.1rem, 4.05vw, 3.55rem); }
  h1 { margin-left: -.045em; font-size: clamp(3.15rem, 5.45vw, 5.05rem); font-weight: 745; line-height: .99; letter-spacing: -.075em; text-wrap: initial; }
  .title-period { color: var(--primary); }
  .intro-copy > p { margin: 1.35rem 0 1.65rem; max-width: 43ch; color: var(--text-secondary); font-size: clamp(1.05rem, 1.62vw, 1.25rem); line-height: 1.46; }
  .intro-copy :global(.guide-search) { max-width: 31.5rem; }
  .lead-guide { display: grid; position: relative; align-content: end; isolation: isolate; min-height: clamp(17rem, 28vw, 22rem); overflow: hidden; border-radius: 10px; outline-offset: 4px; color: #faf5e9; background: #202925; text-decoration: none; }
  .lead-guide::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(12,17,17,.02) 24%, rgba(12,16,15,.64) 60%, #191f1b 100%); }
  .lead-guide img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 45% 43%; filter: brightness(1.32) saturate(0.78); }
  .lead-copy { padding: clamp(1.25rem, 2vw, 1.9rem); }
  .lead-copy .micro-label { color: #ffcc81; }
  .lead-title { display: flex; align-items: center; justify-content: space-between; gap: .55rem; margin: .38rem 0; }
  .lead-title h2 { color: inherit; font-size: clamp(1.43rem, 2.6vw, 2.35rem); text-wrap: pretty; }
  .lead-arrow { display: grid; place-items: center; flex: 0 0 auto; width: 38px; height: 38px; color: #ffcc81; border: 1px solid #a88c64; border-radius: 50%; }
  .lead-guide:hover .lead-arrow { color: #23241f; background: #ffcc81; border-color: #ffcc81; }
  .lead-copy p { color: #f0ebdf; font-size: .93rem; }
  .entry-points { display: grid; grid-template-columns: minmax(0, 1.72fr) minmax(0, 1fr); align-items: start; gap: clamp(1.1rem, 3vw, 2.75rem); border-top: 1px solid var(--border); padding-top: 2rem; }
  .symptoms { padding: 1.12rem 1.2rem .85rem; background: var(--accent-soft); border: 1px solid var(--accent-border); border-inline-start: 3px solid var(--primary); border-radius: var(--radius-md); }
  .symptoms h2 { display: flex; align-items: center; gap: .55rem; font-size: 1.21rem; font-weight: 680; margin-block-end: .45rem; }
  .symptoms h2 :global(svg), .symptoms li :global(svg) { color: var(--primary); flex: none; }
  .symptoms li + li { border-top: 1px solid var(--accent-border); }
  .symptoms li a { display: flex; align-items: center; justify-content: space-between; gap: .55rem; min-height: 43px; padding-block: .18rem; font-size: .94rem; color: var(--text); text-decoration: none; }
  .symptoms li a:hover { text-decoration: underline; color: var(--primary); }
  .more-symptoms { margin-block-start: .3rem; min-height: 35px; font-size: .83rem; }
  .latest, .featured { margin-top: clamp(2.65rem, 5.5vw, 4.55rem); }
  @media (max-width: 64rem) {
    .entry-points { gap: 1.3rem; }
  }
  @media (max-width: 48rem) {
    .intro { grid-template-columns: 1fr; gap: 1.4rem; padding-top: 2.25rem; padding-bottom: 1.8rem; }
    h1 { font-size: clamp(2.1rem, 10.2vw, 4.5rem); }
    .intro-copy > p { margin: .95rem 0 1.15rem; }
    .lead-guide { min-height: clamp(11.5rem, 48vw, 18rem); }
    .lead-guide::before { background: linear-gradient(180deg, rgba(12,16,15,.10), rgba(12,16,15,.66) 22%, rgba(12,16,15,.77) 48%, #191f1b 100%); }
    .entry-points { grid-template-columns: 1fr; gap: 1.65rem; padding-top: 1.6rem; }
  }
  @media (max-width: 23rem) {
    h1 { letter-spacing: -.066em; }
    .intro { padding-top: 1.8rem; }
    .lead-copy { padding: .9rem; }
  }
</style>

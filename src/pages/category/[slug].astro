---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ManualIcon from '../../components/ManualIcon.astro';
import TopicRail from '../../components/TopicRail.astro';
import { getPostsByCategory } from '../../lib/posts';
import { categories } from '../../lib/config';
import { getTopic, publishedTasks } from '../../lib/manual';

export function getStaticPaths() {
  return categories.map(category => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category.slug);
const topic = getTopic(category.slug);
const tasks = publishedTasks(category.slug, posts);
---

<BaseLayout title={`${category.name} Tutorials - ServerHi`} description={category.description}>
  <div class="container">
    <Breadcrumb items={[
      { label: 'Guides', href: '/posts/' },
      { label: category.name, href: `/category/${category.slug}/` },
    ]} />

    <div class="topic-layout">
      <header class="category-heading">
        <span class="category-mark"><ManualIcon name={topic.icon} size={28} /></span>
        <div>
          <h1 class="page-heading">{category.name}</h1>
          <p class="page-intro">{category.description}.</p>
        </div>
      </header>

      <aside class="topic-sidebar"><TopicRail current={category.slug} /></aside>

      <div class="topic-content">
        {tasks.length > 0 && (
          <section class="common-tasks" aria-labelledby="tasks-title">
            <h2 id="tasks-title" class="section-heading">{category.slug === 'troubleshooting' ? 'Find your symptom' : 'Common tasks'}</h2>
            <ul class="list-reset">
              {tasks.map(task => (
                <li><a href={`/posts/${task.slug}/`}>{task.label}<ManualIcon name="diagonal" size={16} /></a></li>
              ))}
            </ul>
          </section>
        )}

        <section aria-labelledby="article-index">
          <div class="section-line">
            <h2 id="article-index" class="section-heading">All articles</h2>
            <span class="micro-label">{posts.length} {posts.length === 1 ? 'article' : 'articles'} · newest first</span>
          </div>
          {posts.length > 0
            ? <ul class="article-list">{posts.map(post => <li><ArticleCard post={post} /></li>)}</ul>
            : <p class="page-intro">Browse <a href="/posts/">all guides</a> while this topic grows.</p>}
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .topic-layout { display: grid; grid-template-columns: 13.5rem minmax(0, 1fr); grid-template-rows: auto 1fr; gap: 2.1rem clamp(1.4rem, 4vw, 3.8rem); }
  .category-heading { grid-column: 2; display: flex; align-items: flex-start; gap: 1rem; padding-block: .6rem .1rem; }
  .category-mark { display: grid; place-items: center; flex: none; width: 54px; height: 54px; margin-top: .4rem; border: 1px solid var(--accent-border); background: var(--accent-soft); color: var(--primary); border-radius: var(--radius-md); }
  .category-heading .page-heading { text-wrap: pretty; }
  .topic-sidebar { grid-column: 1; grid-row: 1 / 3; border-inline-end: 1px solid var(--border); padding: .8rem 1rem 0 0; }
  .topic-sidebar :global(.topic-rail) { position: sticky; top: calc(var(--header-height) + 18px); }
  .topic-content { grid-column: 2; min-width: 0; }
  .common-tasks { padding: 1.1rem 1.15rem .85rem; margin-bottom: 2.15rem; border: 1px solid var(--accent-border); border-inline-start: 3px solid var(--primary); border-radius: var(--radius-md); background: var(--accent-soft); }
  .common-tasks h2 { font-size: 1.19rem; margin-bottom: .35rem; }
  .common-tasks ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr)); gap: .2rem .7rem; }
  .common-tasks a { display: flex; align-items: center; justify-content: space-between; gap: .5rem; min-height: 44px; height: 100%; padding: .28rem .55rem; color: var(--text); text-decoration: none; font-size: .92rem; font-weight: 600; line-height: 1.3; border-block-end: 1px solid var(--accent-border); }
  .common-tasks a :global(svg) { flex: none; color: var(--primary); }
  .common-tasks a:hover { color: var(--primary); text-decoration: underline; }
  @media (max-width: 50rem) {
    .topic-layout { display: flex; flex-direction: column; gap: 1.25rem; }
    .topic-sidebar { border: 0; padding: 0; }
    .topic-sidebar :global(.topic-rail) { position: static; }
    .category-heading { padding: .2rem 0; gap: .8rem; }
    .category-mark { width: 42px; height: 42px; margin-top: .2rem; }
    .category-mark :global(svg) { width: 23px; height: 23px; }
    .category-heading .page-heading { font-size: clamp(1.95rem, 7vw, 3.6rem); }
  }
</style>

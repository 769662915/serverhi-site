---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ManualIcon from '../components/ManualIcon.astro';
import { getAllPosts, type Post } from '../lib/posts';
import { getCategoryBySlug } from '../lib/config';

const posts = await getAllPosts();
const months = new Map<string, Post[]>();
for (const post of posts) {
  const month = post.data.pubDate.toISOString().slice(0, 7);
  const existing = months.get(month);
  if (existing) existing.push(post);
  else months.set(month, [post]);
}
const monthLabel = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', month: 'long', year: 'numeric' });
const dayLabel = new Intl.DateTimeFormat('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' });
---

<BaseLayout title="Archive - ServerHi">
  <div class="container archive-page">
    <Breadcrumb items={[{ label: 'Archive', href: '/archive/' }]} />
    <header>
      <h1 class="page-heading">Article archive</h1>
      <p class="page-intro">{posts.length} articles organized by publication date.</p>
    </header>
    <nav class="archive-months" aria-label="Jump to month">
      {Array.from(months, ([month, entries]) => <a href={`#month-${month}`}>{monthLabel.format(entries[0].data.pubDate)}</a>)}
    </nav>
    {Array.from(months, ([month, entries]) => (
      <section class="archive-group" id={`month-${month}`} aria-labelledby={`heading-${month}`}>
        <h2 id={`heading-${month}`} class="section-heading">{monthLabel.format(entries[0].data.pubDate)}</h2>
        <ul class="list-reset">
          {entries.map(post => (
            <li>
              <a class="archive-row" href={`/posts/${post.slug}/`}>
                <time datetime={post.data.pubDate.toISOString()}>{dayLabel.format(post.data.pubDate)}</time>
                <span class="archive-title">{post.data.title}</span>
                <span class="archive-topic">{getCategoryBySlug(post.data.category)?.name}</span>
                <ManualIcon name="diagonal" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .archive-page { max-width: 68rem; }
  header { margin: .4rem 0 1.3rem; }
  .archive-months { display: flex; flex-wrap: wrap; gap: .32rem .58rem; }
  .archive-months a { display: inline-flex; align-items: center; min-height: 40px; padding: .25rem .55rem; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); text-decoration: none; font-size: .83rem; }
  .archive-months a:hover { border-color: var(--accent-border); color: var(--primary); }
  .archive-group { margin: 2.2rem 0 0; }
  .archive-group h2 { margin-bottom: .6rem; }
  .archive-group ul { border-top: 1px solid var(--border-strong); }
  .archive-group li { border-bottom: 1px solid var(--border); }
  .archive-row { display: grid; grid-template-columns: 4.4rem minmax(0, 1fr) 9rem auto; gap: 0.35rem .7rem; align-items: center; padding: .6rem .25rem .6rem 0; min-height: 45px; color: var(--text); text-decoration: none; font-size: .93rem; }
  .archive-row time, .archive-topic { color: var(--text-secondary); font-size: .8rem; }
  .archive-title { font-weight: 610; overflow-wrap: anywhere; }
  .archive-row :global(svg) { color: var(--primary); }
  .archive-row:hover .archive-title { color: var(--primary); text-decoration: underline; }
  @media (max-width: 42rem) {
    .archive-row { grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: start; }
    .archive-topic { grid-row: 2; grid-column: 2; }
    .archive-row :global(svg) { grid-row: 1; grid-column: 3; }
  }
</style>

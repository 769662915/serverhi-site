---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ManualIcon from '../../components/ManualIcon.astro';
import { getAllPosts, groupPostsByTag, isNavigationOnlyTag } from '../../lib/posts';

export async function getStaticPaths() {
  return groupPostsByTag(await getAllPosts()).map(group => ({
    params: { slug: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
const { slug, name, posts } = group;
const count = `${posts.length} ${posts.length === 1 ? 'article' : 'articles'}`;
const description = `${count} on ${name}. Start with ${posts[0].data.title}.`;
const navigationOnly = isNavigationOnlyTag(group);
---

<BaseLayout title={`${name} Tutorials - ServerHi`} description={description} noindex={navigationOnly}>
  <div class="container tag-page">
    <Breadcrumb items={[{ label: 'Guides', href: '/posts/' }, { label: name, href: `/tag/${slug}/` }]} />
    <header>
      <h1 class="page-heading">{name}</h1>
      <p class="page-intro">{count} on this topic</p>
      {navigationOnly && <a class="text-link" href="/tag/docker-compose/">Browse all Docker Compose articles <ManualIcon name="arrow" size={16} /></a>}
    </header>
    <ul class="article-list">
      {posts.map(post => <li><ArticleCard post={post} heading="h2" showCategory /></li>)}
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-page { max-width: 62rem; }
  header { padding: .4rem 0 1.8rem; }
  header .text-link { min-height: 44px; margin-top: .2rem; }
</style>

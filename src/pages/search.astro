---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SearchField from '../components/SearchField.astro';
const examples = ['nginx 502', 'docker compose', 'postgres backup', 'disk space'];
---

<BaseLayout noindex title="Search - ServerHi">
  <div class="container search-page">
    <Breadcrumb items={[{ label: 'Search', href: '/search/' }]} />
    <header>
      <h1 class="page-heading">Search the manual</h1>
      <p class="page-intro">Look up a command, a service, or the error you’re seeing.</p>
    </header>
    <SearchField id="manual-query" placeholder="Search guides…" visibleLabel />
    <nav aria-label="Example searches" class="examples">
      {examples.map(query => <a href={`/search/?q=${encodeURIComponent(query)}`}>{query}</a>)}
    </nav>
    <noscript><p class="search-note">Live search requires JavaScript. <a href="/archive/">Browse the article archive</a>.</p></noscript>
    <p id="search-status" class="search-note" role="status"></p>
    <ol id="search-results" class="list-reset" aria-label="Search results"></ol>
  </div>
</BaseLayout>

<script is:inline>
  const input = document.getElementById('manual-query');
  const results = document.getElementById('search-results');
  const status = document.getElementById('search-status');
  const form = input.form;
  if (!input.value) input.value = new URLSearchParams(location.search).get('q') || '';
  let revision = 0;
  let timeout;
  let index;

  function schedule(delay = 0) {
    clearTimeout(timeout);
    const request = ++revision;
    timeout = setTimeout(() => search(request), delay);
  }

  async function search(request) {
    const query = input.value.trim();
    const url = new URL(location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    if (url.href !== location.href) history.replaceState(history.state, '', url);

    results.replaceChildren();
    status.textContent = '';
    if (query.length < 2) return;
    status.textContent = 'Searching…';

    try {
      index ??= import('/pagefind/pagefind.js').then(async module => {
        await module.options({ excerptLength: 18 });
        return module;
      }).catch(error => { index = undefined; throw error; });
      const engine = await index;
      if (request !== revision) return;
      const matches = await engine.search(query);
      if (request !== revision) return;

      // Asset hashes in automatic image metadata are unrelated to a guide's text.
      const relevant = matches.results.filter(result =>
        result.words?.length || !result.matchedMetaFields?.includes('image')
        || result.matchedMetaFields.some(field => field !== 'image')
      );
      const items = await Promise.all(relevant.slice(0, 10).map(result => result.data()));
      if (request !== revision) return;

      status.textContent = items.length
        ? `Showing ${items.length} of ${relevant.length} results for “${query}”.`
        : `No results for “${query}”.`;

      for (const item of items) {
        const li = document.createElement('li');
        li.className = 'search-result-item';
        const heading = document.createElement('h2');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.meta.title;
        const excerpt = document.createElement('p');
        excerpt.textContent = item.plain_excerpt;
        heading.append(link);
        li.append(heading, excerpt);
        results.append(li);
      }
    } catch {
      if (request !== revision) return;
      status.textContent = 'Search could not load. ';
      const retry = document.createElement('a');
      retry.href = url.pathname + url.search;
      retry.textContent = 'Reload this search';
      status.append(retry);
    }
  }

  input.addEventListener('input', () => schedule(125));
  form.addEventListener('submit', event => { event.preventDefault(); schedule(); });
  window.addEventListener('popstate', () => {
    input.value = new URLSearchParams(location.search).get('q') || '';
    schedule();
  });
  schedule();
</script>

<style>
  .search-page { max-width: 51rem; }
  header { margin: .4rem 0 1.35rem; }
  .examples { display: flex; flex-wrap: wrap; gap: .28rem .55rem; margin-top: .6rem; }
  .examples a { display: inline-flex; align-items: center; padding: .3rem .55rem; min-height: 36px; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-family: var(--font-code); font-size: .76rem; text-decoration: none; background: var(--surface-muted); }
  .examples a:hover { color: var(--primary); border-color: var(--accent-border); text-decoration: underline; }
  .search-note { color: var(--text-secondary); padding-top: 1.15rem; font-size: .96rem; }
  .search-note:empty { padding: 0; }
  :global(.search-result-item) { padding: 1rem 0; border-block-end: 1px solid var(--border); }
  :global(.search-result-item:first-child) { border-block-start: 1px solid var(--border-strong); margin-top: .75rem; }
  :global(.search-result-item h2) { margin: 0 0 .3rem; font-size: 1.14rem; font-weight: 640; letter-spacing: -.019em; text-wrap: pretty; }
  :global(.search-result-item a) { color: var(--text); text-decoration: none; }
  :global(.search-result-item a:hover) { color: var(--primary); text-decoration: underline; }
  :global(.search-result-item p) { color: var(--text-secondary); font-size: .94rem; }
</style>

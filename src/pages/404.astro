---
import BaseLayout from '../layouts/BaseLayout.astro';
import ManualIcon from '../components/ManualIcon.astro';
import SearchField from '../components/SearchField.astro';
---
<BaseLayout noindex title="404 - Page Not Found - ServerHi">
  <div class="container missing">
    <p class="micro-label">404</p>
    <h1 class="page-heading">Page not found</h1>
    <SearchField id="missing-search" />
    <nav aria-label="Find another guide">
      <a class="text-link" href="/">ServerHi home <ManualIcon name="arrow" size={16} /></a>
      <a class="text-link" href="/posts/">All guides <ManualIcon name="arrow" size={16} /></a>
      <a class="text-link" href="/archive/">Archive <ManualIcon name="arrow" size={16} /></a>
    </nav>
  </div>
</BaseLayout>
<style>
  .missing { max-width: 37rem; padding: clamp(3rem, 10vw, 7rem) 0 1rem; }
  .missing .micro-label { color: var(--primary); margin-bottom: .5rem; }
  .page-heading { margin-bottom: 1.45rem; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem 1.3rem; margin-top: .65rem; }
  nav a { min-height: 44px; }
</style>

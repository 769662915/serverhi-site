---
import ManualIcon from './ManualIcon.astro';
interface Props {
  items: Array<{ label: string; href: string }>;
  trailOnly?: boolean;
}
const { items, trailOnly = false } = Astro.props;
const trail = [{ label: 'Home', href: '/' }, ...items];
---
<nav data-pagefind-ignore class="breadcrumb" aria-label="Breadcrumb">
  <ol class="list-reset">
    {trail.map((item, index) => (
      <li>
        {index > 0 && <ManualIcon name="right" size={12} />}
        {index === trail.length - 1 && !trailOnly
          ? <span aria-current="page">{item.label}</span>
          : <a href={item.href}>{item.label}</a>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb { margin: 1.15rem 0 1.65rem; font-size: .83rem; }
  ol, li { display: flex; flex-wrap: wrap; align-items: center; gap: 0.28rem .5rem; }
  li { color: var(--text-secondary); }
  a { display: inline-flex; align-items: center; min-height: 28px; text-decoration: none; color: var(--text-secondary); }
  a:hover { color: var(--primary); text-decoration: underline; }
  span { color: var(--text); font-weight: 620; }
  @media (max-width: 48rem) { .breadcrumb { margin: .75rem 0 1.05rem; } }
</style>

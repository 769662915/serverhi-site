---
import ManualIcon from './ManualIcon.astro';
import { getCategoryBySlug } from '../lib/config';
import { type Post, formatDate } from '../lib/posts';

interface Props {
  post: Post;
  heading?: 'h2' | 'h3';
  showCategory?: boolean;
  showDescription?: boolean;
}
const { post, heading: Heading = 'h3', showCategory = false, showDescription = true } = Astro.props;
const { title, description, category, pubDate, estimatedTime } = post.data;
const categoryName = getCategoryBySlug(category)?.name;
---
<article class="guide-row">
  <div class="guide-row-copy">
    <Heading><a href={`/posts/${post.slug}/`}>{title}</a></Heading>
    {showDescription && <p>{description}</p>}
    <div class="guide-row-meta">
      {showCategory && categoryName && <span>{categoryName}</span>}
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {estimatedTime && <span>{estimatedTime}</span>}
    </div>
  </div>
  <span class="guide-row-arrow"><ManualIcon name="diagonal" size={17} /></span>
</article>

<style>
  .guide-row { display: flex; position: relative; justify-content: space-between; align-items: flex-start; gap: .7rem; padding: 1.05rem .25rem 1.05rem 0; min-width: 0; }
  .guide-row-copy { min-width: 0; }
  h2, h3 { margin: 0; font-size: clamp(1.02rem, 2vw, 1.18rem); line-height: 1.32; font-weight: 665; letter-spacing: -0.018em; text-wrap: pretty; }
  a { color: var(--text); text-decoration: none; }
  a::after { content: ''; position: absolute; inset: 0; }
  .guide-row:hover a { color: var(--primary); text-decoration: underline; }
  .guide-row-arrow { padding-top: 0.15rem; color: var(--primary); line-height: 0; flex: none; }
  p { margin-top: .32rem; max-width: 70ch; font-size: .93rem; line-height: 1.47; color: var(--text-secondary); }
  .guide-row-meta { display: flex; flex-wrap: wrap; gap: .15rem .6rem; margin-top: .48rem; color: var(--text-secondary); font-size: .8rem; }
  .guide-row-meta > * + *::before { content: '·'; margin-right: .6rem; }
</style>

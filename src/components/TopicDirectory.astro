---
import ManualIcon from './ManualIcon.astro';
import { categories } from '../lib/config';
import { getTopic } from '../lib/manual';

const { compact = false } = Astro.props;
---
<ul class:list={['topic-directory', 'list-reset', { compact }]}>
  {categories.map(category => {
    const topic = getTopic(category.slug);
    return (
      <li>
        <a href={`/category/${category.slug}/`}>
          <span class="topic-icon"><ManualIcon name={topic.icon} size={22} /></span>
          <div class="topic-text"><strong>{category.name}</strong><span>{topic.summary}</span></div>
          <span class="topic-arrow"><ManualIcon name="diagonal" size={16} /></span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .topic-directory { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.35rem; border-block-start: 1px solid var(--border-strong); }
  li { border-block-end: 1px solid var(--border); }
  a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .72rem; min-height: 80px; padding: .55rem .25rem .55rem 0; color: var(--text); text-decoration: none; }
  .topic-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: var(--surface-muted); color: var(--text); }
  .topic-text { display: grid; gap: .14rem; }
  strong { font-size: 1rem; line-height: 1.26; font-weight: 665; letter-spacing: -.014em; }
  .topic-text > span { color: var(--text-secondary); font-size: .82rem; line-height: 1.3; }
  .topic-arrow { line-height: 0; color: var(--primary); }
  a:hover strong { color: var(--primary); text-decoration: underline; }
  a:hover .topic-icon { background: var(--accent-soft); border-color: var(--accent-border); }
  .compact a { min-height: 67px; }
  @media (max-width: 36rem) {
    .topic-directory { grid-template-columns: 1fr; }
    a { min-height: 63px; }
    .topic-icon { width: 37px; height: 37px; }
  }
</style>

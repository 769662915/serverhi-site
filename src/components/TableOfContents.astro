---
import ManualIcon from './ManualIcon.astro';

interface Heading {
  depth: number;
  text: string;
  slug: string;
}
interface Props {
  headings: Heading[];
  collapsible?: boolean;
}
const { headings, collapsible = false } = Astro.props;
const sections = headings.filter(heading => heading.slug && (heading.depth === 2 || heading.depth === 3));
---
{sections.length > 0 && (
  <nav aria-label="On this page" class="contents" data-pagefind-ignore>
    {collapsible ? (
      <details class="contents-disclosure">
        <summary><ManualIcon name="list" size={17} /> On this page <span><ManualIcon name="down" size={16} /></span></summary>
        <ul class="list-reset">
          {sections.map(heading => (
            <li class:list={[{ subheading: heading.depth === 3 }]}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ul>
      </details>
    ) : (
      <>
        <p class="contents-title">On this page</p>
        <ul class="list-reset">
          {sections.map(heading => (
            <li class:list={[{ subheading: heading.depth === 3 }]}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ul>
      </>
    )}
  </nav>
)}

<style>
  .contents { min-width: 0; }
  .contents-title { border-bottom: 1px solid var(--border); margin-bottom: .35rem; padding: 0 0 .65rem; font-size: .94rem; font-weight: 675; }
  a { display: block; border-inline-start: 2px solid transparent; padding: .45rem .55rem .45rem .5rem; color: var(--text-secondary); text-decoration: none; font-size: .87rem; font-weight: 520; line-height: 1.35; overflow-wrap: anywhere; }
  a:hover, a[aria-current] { color: var(--primary); background: var(--accent-soft); border-inline-start-color: var(--primary); }
  a:focus-visible { outline-offset: -2px; }
  .subheading a { padding-inline-start: 1.22rem; font-size: .8rem; }
  details { border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); }
  details ul { border-top: 1px solid var(--border); padding: .25rem .5rem; }
  details a { padding-block: .7rem; }
  summary { min-height: 44px; padding: .55rem .72rem; gap: .55rem; display: flex; align-items: center; color: var(--text); font-size: .94rem; font-weight: 650; list-style: none; }
  summary span { display: flex; margin-inline-start: auto; }
  summary::-webkit-details-marker { display: none; }
  details[open] summary span { transform: rotate(180deg); }
</style>

---
import ManualIcon from './ManualIcon.astro';
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/posts/', label: 'Guides' },
  { href: '/#topics', label: 'Topics' },
  { href: '/category/troubleshooting/', label: 'Troubleshooting' },
  { href: '/archive/', label: 'Archive' },
];
const here = Astro.url.pathname;
const currentSection = (href: string) => here === href
  || (href === '/posts/' && here.startsWith('/posts/'))
  || (href === '/#topics' && here.startsWith('/category/') && here !== '/category/troubleshooting/');
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner container">
    <Wordmark />

    <nav class="header-nav" aria-label="Main navigation">
      {nav.map(({ href, label }) => (
        <a href={href} class:list={[{ active: currentSection(href) }]} aria-current={here === href ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="header-search" href="/search/" aria-label="Search guides" aria-current={here === '/search/' ? 'page' : undefined}>
        <ManualIcon name="search" size={19} />
        <span>Search guides</span>
      </a>

      <button class="icon-control" id="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" hidden>
        <span class="icon-moon"><ManualIcon name="moon" size={18} /></span>
        <span class="icon-sun"><ManualIcon name="sun" size={19} /></span>
      </button>

      <details id="mobile-menu" class="mobile-menu">
        <summary class="icon-control" aria-label="Toggle menu">
          <span class="menu-icon"><ManualIcon name="menu" size={22} /></span>
          <span class="close-icon"><ManualIcon name="close" size={22} /></span>
        </summary>
        <nav class="mobile-nav" aria-label="Main navigation">
          {nav.map(({ href, label }) => (
            <a href={href} aria-current={here === href ? 'page' : undefined} class:list={[{ active: currentSection(href) }]}>
              {label}<ManualIcon name="right" size={16} />
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    const menu = document.getElementById('mobile-menu');
    if (button) {
      const sync = () => button.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
      sync();
      button.hidden = false;
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
      systemTheme.addEventListener('change', sync);
    }
    if (menu) {
      menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
        if (link.hash && link.pathname === location.pathname) menu.open = false;
      }));
      menu.addEventListener('focusout', event => {
        if (menu.open && event.relatedTarget && !menu.contains(event.relatedTarget)) menu.open = false;
      });
      document.addEventListener('click', event => {
        if (menu.open && !menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary').focus();
        }
      });
      window.addEventListener('pagehide', () => { menu.open = false; });
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }
  .header-inner { display: flex; align-items: center; min-height: calc(var(--header-height) - 1px); gap: clamp(1.4rem, 4vw, 4rem); }
  .header-nav { display: flex; align-items: stretch; align-self: stretch; gap: clamp(0.9rem, 2.25vw, 2rem); }
  .header-nav a { position: relative; display: grid; place-items: center; text-decoration: none; color: var(--text-secondary); font-size: 0.91rem; font-weight: 620; }
  .header-nav a:hover, .header-nav .active { color: var(--text); }
  .header-nav .active::after { content: ''; position: absolute; inset: auto 0 0; height: 2px; background: var(--primary); }
  .header-nav a:focus-visible { outline-offset: -3px; }
  .header-actions { display: flex; align-items: center; margin-inline-start: auto; gap: 0.45rem; }
  .icon-control, .header-search { min-width: 44px; min-height: 44px; border-radius: var(--radius-sm); display: inline-flex; align-items: center; justify-content: center; gap: 0.48rem; color: var(--text); background: transparent; text-decoration: none; }
  .header-search { padding-inline: 0.85rem; border: 1px solid var(--border); font-size: 0.89rem; font-weight: 560; }
  .icon-control { border: 0; padding: 0; list-style: none; }
  .icon-control[hidden] { display: none; }
  .icon-control:hover, .header-search:hover, .header-search[aria-current] { background: var(--surface-muted); }
  .icon-moon, .icon-sun, .menu-icon, .close-icon { line-height: 0; }
  .icon-sun, .close-icon, :global([data-theme='dark']) .icon-moon, .mobile-menu[open] .menu-icon { display: none; }
  :global([data-theme='dark']) .icon-sun, .mobile-menu[open] .close-icon { display: block; }
  .mobile-menu { display: none; }
  summary::-webkit-details-marker { display: none; }
  .mobile-nav { position: absolute; inset: 100% 0 auto; background: var(--surface); border-block-end: 1px solid var(--border-strong); padding: 0.5rem var(--gutter) 0.75rem; max-height: calc(100dvh - var(--header-height)); overflow: auto; }
  .mobile-nav a { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 46px; padding: 0.3rem 0.35rem; color: var(--text); text-decoration: none; font-weight: 620; }
  .mobile-nav a + a { border-block-start: 1px solid var(--border); }
  .mobile-nav a:hover, .mobile-nav .active { color: var(--primary); }
  @media (max-width: 48rem) {
    .header-nav, .header-search span { display: none; }
    .mobile-menu { display: block; }
    .header-actions { gap: 0.125rem; }
    .header-search { padding: 0; border: 0; }
  }
  @media (max-width: 23rem) {
    .header-inner { gap: 0.25rem; }
  }
</style>

---
import { site } from '../lib/config';
import ThemeToggle from './ThemeToggle';
const navigation = [
  { href: '/', label: 'Home', icon: '🏠' },
  { href: '/posts/', label: 'Tutorials', icon: '📚' },
  { href: '/category/docker/', label: 'Docker', icon: '🐳' },
  { href: '/category/linux/', label: 'Linux', icon: '🐧' },
  { href: '/category/devops/', label: 'DevOps', icon: '🚀' },
  { href: '/search/', label: 'Search', icon: '🔍' },
];
---

<header class="site-header">
  <div class="container">
    <div class="header-content">
      <a href="/" class="logo terminal-hover">
        <span class="logo-bracket">[</span>
        <span class="logo-text glow-primary">{site.name}</span>
        <span class="logo-bracket">]</span>
      </a>

      <nav class="main-nav" aria-label="Main navigation">
        {navigation.map(item => <a href={item.href} class="nav-link terminal-hover">{item.label}</a>)}
      </nav>

      <div class="header-actions">
        <ThemeToggle client:load />
        <details class="mobile-menu-wrapper" id="mobile-menu">
          <summary class="mobile-menu-toggle" aria-label="Toggle menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </summary>
          <div class="mobile-menu-overlay">
            <nav class="mobile-nav" aria-label="Main navigation">
              {navigation.map(item => (
                <a href={item.href} class="mobile-nav-link terminal-hover">
                  <span class="nav-icon" aria-hidden="true">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              ))}
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobile-menu');
  if (menu) {
    menu.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.matches('.mobile-menu-overlay')) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    window.addEventListener('pagehide', () => { menu.open = false; });
  }
</script>

<style>
  .site-header {
    background: rgba(var(--surface-rgb), 0.85);
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .logo-bracket {
    color: var(--secondary);
  }

  .logo-text {
    color: var(--primary);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    justify-content: center;
  }

  .nav-link {
    font-family: var(--font-code);
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link::before {
    content: '> ';
    color: var(--primary);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    color: var(--primary);
  }

  .nav-link:hover::before {
    opacity: 1;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mobile-menu-wrapper {
    display: none;
  }

  @media (max-width: 768px) {
    .main-nav {
      display: none;
    }

    .mobile-menu-wrapper {
      display: block;
    }

    .logo {
      font-size: 1.25rem;
    }
  }
</style>

<style is:global>
  /* 汉堡菜单按钮样式 */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 2rem;
    height: 2rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 10000;
    position: relative;
  }

  .mobile-menu-toggle::-webkit-details-marker { display: none; }

  @media (max-width: 768px) {
    body:has(.mobile-menu-wrapper[open]) { overflow: hidden; }
  }

  .hamburger-line {
    width: 2rem;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .mobile-menu-wrapper[open] .mobile-menu-toggle .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translateY(0.5rem);
  }

  .mobile-menu-wrapper[open] .mobile-menu-toggle .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-wrapper[open] .mobile-menu-toggle .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translateY(-0.5rem);
  }

  /* 移动端菜单覆盖层 */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    background: var(--background);
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    padding-top: 5rem;
    overflow-y: auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .mobile-menu-wrapper[open] .mobile-menu-overlay {
    opacity: 1;
    visibility: visible;
  }

  /* 移动端导航 */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
  }

  .mobile-nav-link {
    font-family: var(--font-code);
    font-size: 1.25rem;
    color: var(--text-secondary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 2rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    width: 100%;
    max-width: 300px;
    transition: all 0.3s ease;
    background: var(--surface);
  }

  .mobile-nav-link:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: rgba(var(--primary-rgb), 0.1);
    transform: translateX(0.5rem);
  }

  .nav-icon {
    font-size: 1.5rem;
  }
</style>

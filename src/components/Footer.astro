---
import Wordmark from './Wordmark.astro';
import ManualIcon from './ManualIcon.astro';
import { categories } from '../lib/config';

const sections = [
  { label: 'Topics', links: categories.map(category => ({ label: category.name, href: `/category/${category.slug}/` })) },
  { label: 'Publication', links: [
    { label: 'All guides', href: '/posts/' }, { label: 'Archive', href: '/archive/' },
    { label: 'About', href: '/about/' }, { label: 'Editorial team', href: '/author/' },
    { label: 'Editorial policy', href: '/editorial-policy/' }, { label: 'Contact & corrections', href: '/contact/' },
  ] },
  { label: 'Site information', links: [
    { label: 'Privacy Policy', href: '/privacy/' }, { label: 'Terms of Service', href: '/terms/' },
    { label: 'Disclaimer', href: '/disclaimer/' },
  ] },
];
---
<footer class="site-footer" data-pagefind-ignore>
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <Wordmark />
        <p>Linux &amp; infrastructure guides.</p>
        <a class="text-link rss-link" href="/rss.xml"><ManualIcon name="rss" size={16} /> RSS feed</a>
      </div>
      {sections.map((section) => (
        <nav aria-label={`Footer ${section.label.toLowerCase()}`}>
          <h2>{section.label}</h2>
          <ul class="list-reset">
            {section.links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <p class="copyright">© {new Date().getUTCFullYear()} ServerHi</p>
  </div>
</footer>
<style>
  .site-footer { margin-top: 4.5rem; padding: 2.45rem 0 1.3rem; border-top: 1px solid var(--border); background: var(--surface-muted); }
  .footer-inner { display: grid; grid-template-columns: 1.28fr 1fr 1fr .75fr; gap: 2rem 1.4rem; }
  .footer-brand p { margin: .55rem 0 .75rem; font-size: .93rem; color: var(--text-secondary); }
  .site-footer h2 { margin-bottom: .55rem; font-size: .96rem; letter-spacing: -0.012em; }
  .site-footer nav a { display: inline-block; padding: .2rem 0; color: var(--text-secondary); text-decoration: none; font-size: .89rem; }
  .site-footer nav a:hover { color: var(--primary); text-decoration: underline; }
  .rss-link { min-height: 33px; }
  .copyright { border-top: 1px solid var(--border); margin-top: 1.6rem; padding-top: 1.15rem; color: var(--text-secondary); font-size: .82rem; }
  @media (max-width: 48rem) {
    .footer-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer { margin-top: 3rem; }
    .site-footer nav a { padding-block: .36rem; }
  }
  @media (max-width: 30rem) {
    .footer-inner { gap: 1.4rem 1rem; }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>

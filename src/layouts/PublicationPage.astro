---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<BaseLayout title={`${title} - ServerHi`} description={description}>
  <article class="publication-page container">
    <h1 class="terminal-prompt">{title}</h1>
    <p class="introduction">{description}</p>
    <slot />
  </article>
</BaseLayout>

<style>
  .publication-page { max-width: 52rem; margin: 0 auto; padding: 1rem 1.25rem 4rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.2; }
  .introduction { color: var(--text-secondary); font-size: 1.15rem; }
  .publication-page :global(h2) { margin: 2rem 0 0.6rem; font-size: 1.45rem; }
  .publication-page :global(p), .publication-page :global(li) { line-height: 1.7; }
  .publication-page :global(ul) { padding-left: 1.4rem; }
  .publication-page :global(li) { margin: 0.4rem 0; }
  .publication-page :global(a) { text-underline-offset: 0.18em; }
</style>
